# Copy to backend/.env and adjust. Never commit the real .env.
DATABASE_PATH=./data/app.db

# Local http development only; keep true in production (HTTPS).
COOKIE_SECURE=true

# Front-end origins allowed to call the API with the session cookie.
CORS_ORIGINS=["http://localhost:5173"]

ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
SCAN_TIMEOUT_SECONDS=1800
MAX_ACTIVE_SCANS_PER_ORGANIZATION=2
